# SchoolLink — environment variable template
# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# ── Database ──────────────────────────────────
DB_USER=schoollink
DB_PASSWORD=your_db_password_here
DB_NAME=schoollink_db
DB_HOST=localhost
DB_PORT=5432

# ── API ───────────────────────────────────────
API_PORT=3000

# ── WorkOS AuthKit ────────────────────────────
# Get these from workos.com → your application → API Keys
# Use sk_test_... keys for dev, sk_live_... for production
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
